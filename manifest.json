{
  "manifest_version": 3,
  "name": "Spotify Custom Rewind",
  "description": "Choose how many seconds Spotify Web Player rewinds.",
  "version": "1.1.0",
  "permissions": ["storage"],
  "action": {
    "default_title": "Spotify Custom Rewind",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
